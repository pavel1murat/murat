# -*- mode: tcl -*-
#------------------------------------------------------------------------------
# copy , use -s or -S and -o
#------------------------------------------------------------------------------
#include "Offline/fcl/minimalMessageService.fcl"
#include "Offline/fcl/standardProducers.fcl"
#include "Offline/fcl/standardServices.fcl"

process_name: copy

source: {
    module_type: RootInput
    compactEventRanges : true
    fileNames: [ "/data/mu2e/mu2etrk/datasets/kpp00s003r109n000/raw.mu2e.kpp00s003r109n000.filter_tc_only_r109.125472_000001.art" ]
    maxEvents: -1
}

outputs: {

    outfile : {
	module_type    : RootOutput
	fileName       : "raw.mu2e.kpp00s003r109n000.filter_tc_only_r109.125472_000001.art"
	fastCloning    : false
	outputCommands : [ "keep *_*_*_*" ]
    }
}

physics: {
#------------------------------------------------------------------------------
# paths
#------------------------------------------------------------------------------
    p1 : [ ]
    e1 : [ outfile ]

    trigger_paths  : [ p1 ]
    end_paths      : [ e1 ]
}
