# -*- mode: tcl -*-
###############################################################################
# use DumpGeometry - common module for all subdetectors
# 2026-09-17: dump the CRV geometry in extracted position
###############################################################################
#include "Stntuple/fcl/stntuple_prologs.fcl"
#include "murat/fcl/prolog.fcl"
#include "Stntuple/fcl/stntuple_templates.fcl"

process_name : DumpCRVNumerology

source       : { module_type : EmptyEvent    }

physics : {
    analyzers :  { @table::murat.analyzers }
    e1         : [ DumpGeometry ]
    end_paths  : [ e1           ]
}
#------------------------------------------------------------------------------
physics.analyzers.DumpGeometry.dumpCRVNumerology : 1
services.GeometryService.bFieldFile              : "Offline/Mu2eG4/geom/bfgeom_no_field.txt"
services.GeometryService.inputFile               : "Offline/Mu2eG4/geom/geom_common_extracted.txt"
