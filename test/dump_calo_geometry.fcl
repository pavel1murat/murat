# -*- mode: tcl -*-
###############################################################################
# Print key numbers describing the Mu2e calorimeter geometry
###############################################################################
#include "Stntuple/fcl/stntuple_prologs.fcl"
#include "murat/fcl/prolog.fcl"
#include "Stntuple/fcl/stntuple_templates.fcl"

process_name : DumpCaloGeometry

source       : { module_type : EmptyEvent    }

physics : {
    analyzers :  { @table::murat.analyzers }
    e1         : [ DumpGeometry ]
    end_paths  : [ e1           ]
}
#------------------------------------------------------------------------------
physics.analyzers.DumpGeometry.dumpCaloGeometry : 1
services.GeometryService.inputFile : "Offline/Mu2eG4/geom/geom_common_extracted.txt"
